// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  nombre   String
  email    String
  whatsapp String

  objetivo       String
  experiencia    String
  disponibilidad String

  lesiones String?
  mensaje  String?

  source String?
  status String  @default("new") // new | contacted | approved | rejected

  inviteToken String?   @unique
  invitedAt   DateTime?

  approvedAt DateTime?
  profiles   Profile[]
}

model Profile {
  id        String   @id // clerk user id
  createdAt DateTime @default(now())

  role   String // coach | client
  email  String
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])
}

model Subscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId               String
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  @@index([userId])
}

model Coach {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  name        String?
  email       String?
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients ClientProfile[]
}

model ClientProfile {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  coachId     String?
  coach       Coach?  @relation(fields: [coachId], references: [id])

  nombre         String?
  email          String?
  alturaCm       Int?
  pesoKg         Float?
  meta           String?
  experiencia    String?
  lesiones       String?
  disponibilidad String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trainingPlans  TrainingPlan[]
  nutritionPlans NutritionPlan[]

  @@index([coachId])
}

model TrainingPlan {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title     String
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  days TrainingDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, isActive])
}

model TrainingDay {
  id     String       @id @default(cuid())
  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 1..7 (Lun..Dom)
  name      String? // "Pierna A", "Push", etc.
  notes     String?

  exercises TrainingExercise[]
  order     Int                @default(0)

  @@index([planId, dayOfWeek])
}

model TrainingExercise {
  id    String      @id @default(cuid())
  dayId String
  day   TrainingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  name    String // "Sentadilla"
  sets    Int?
  reps    String? // "6-8", "12", "AMRAP"
  rir     String? // "2", "1-2"
  restSec Int?
  tempo   String?
  notes   String?

  order Int @default(0)

  @@index([dayId, order])
}

// ── CU-09 · PLAN NUTRICIONAL (vigencia por plazo determinado) ─────────────────

model NutritionPlan {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title    String
  isActive Boolean @default(true)

  // El plazo es obligatorio: define hasta cuándo rige el plan
  startDate DateTime
  endDate   DateTime

  // Objetivos diarios del plazo
  kcal      Int?
  proteinaG Int?
  carbsG    Int?
  grasasG   Int?

  notes String?

  meals NutritionMeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, isActive])
  @@index([clientId, endDate])
}

model NutritionMeal {
  id     String        @id @default(cuid())
  planId String
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  name  String // "Desayuno", "Merienda AM", "Almuerzo"
  time  String? // "07:00"
  notes String?

  items NutritionItem[]
  order Int             @default(0)

  @@index([planId, order])
}

model NutritionItem {
  id     String        @id @default(cuid())
  mealId String
  meal   NutritionMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  name     String // "Arroz integral"
  cantidad String? // "150 g", "1 taza"
  kcal     Int?
  proteina Float?
  carbs    Float?
  grasas   Float?
  notes    String?

  order Int @default(0)

  @@index([mealId, order])
}
